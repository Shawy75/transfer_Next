---
import '@/styles/global.css';
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import BaseHead, { type SeoProps } from '@/components/BaseHead.astro';
import InkDefs from '@/components/InkDefs.astro';
import Masthead from '@/components/Masthead.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BackToTop from '@/components/BackToTop.astro';

interface Props extends SeoProps {
  /** Page language when it differs from the site locale. */
  lang?: string;
  /** Home page: shows the large masthead with the intro. */
  home?: boolean;
  /** Let the page use the full content width instead of the reading column. */
  wide?: boolean;
}

const { lang, home = false, wide = false, ...seo } = Astro.props;
const t = useStrings(SITE.locale);
const accentCss = `:root{--accent:${SITE.accent.light}}:root[data-theme='dark']{--accent:${SITE.accent.dark}}`;
---

<!doctype html>
<html lang={lang ?? SITE.locale}>
  <head>
    <BaseHead {...seo} />
    <style is:inline set:html={accentCss}></style>
    <script is:inline define:vars={{ defaultTheme: SITE.defaultTheme }}>
      // Runs before first paint so there is no flash of the wrong colour scheme.
      let theme = defaultTheme;
      try {
        theme = localStorage.getItem('sumi-theme') || defaultTheme;
      } catch {}
      if (theme === 'auto') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = theme;
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <InkDefs />
    <Masthead full={home} />
    <Nav />
    <main id="main" class:list={['main', { wide: wide || home }]}>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

<style>
  .main {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 40px 16px 0;
  }

  .main.wide {
    padding-top: 0;
    padding-inline: 0;
  }
</style>
