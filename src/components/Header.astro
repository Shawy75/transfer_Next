---
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import Icon from './Icon.astro';
import { withBase } from '@/utils/url';

const t = useStrings(SITE.locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const home = withBase('/').replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const target = withBase(href).replace(/\/$/, '') || '/';
  if (target === home) return path === home || new RegExp(`^${home === '/' ? '' : home}/\\d+$`).test(path);
  return path === target || path.startsWith(`${target}/`);
}
---

<header class="site-header card">
  <div class="brand">
    <div class="brand-text">
      <a class="site-title" href={withBase('/')}>{SITE.title}</a>
      <p class="site-subtitle">{SITE.subtitle}</p>
    </div>
    <div class="brand-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t.toggleTheme} title={t.toggleTheme}>
        <span class="when-dark"><Icon name="sun" /></span>
        <span class="when-light"><Icon name="moon" /></span>
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={t.toggleMenu}
        data-menu-toggle
      >
        <span class="when-closed"><Icon name="menu" /></span>
        <span class="when-open"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <nav class="site-nav" id="site-nav" aria-label="Main">
    <ul>
      {
        SITE.nav.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.icon && <Icon name={item.icon} size={16} />}
              <span>{item.text}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={withBase('/search/')} aria-current={isActive('/search/') ? 'page' : undefined}>
          <Icon name="search" size={16} />
          <span>{t.search}</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    overflow: hidden;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem;
    background: var(--ink);
    color: var(--on-ink);
  }

  .brand-text {
    min-width: 0;
  }

  .site-title {
    display: inline-block;
    color: inherit;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .site-title:hover {
    text-decoration: none;
  }

  .site-subtitle {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    opacity: 0.7;
  }

  .brand-actions {
    display: flex;
    gap: 0.25rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.8;
    transition:
      opacity 0.2s,
      background 0.2s;
  }

  .icon-btn:hover {
    opacity: 1;
    background: rgb(255 255 255 / 0.1);
  }

  :global(:root[data-theme='dark']) .icon-btn > .when-light,
  :global(:root:not([data-theme='dark'])) .icon-btn > .when-dark {
    display: none;
  }

  .menu-toggle {
    display: none;
  }

  .icon-btn > span {
    display: grid;
  }

  .icon-btn > .when-open {
    display: none;
  }

  .site-nav ul {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 1.4rem;
    color: var(--text-soft);
    font-size: 0.925rem;
    border-left: 3px solid transparent;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .site-nav a:hover {
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    border-left-color: var(--accent);
    background: var(--surface-2);
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 991px) {
    .brand {
      padding: 0.9rem 1rem;
    }

    .site-title {
      font-size: 1.25rem;
    }

    .menu-toggle {
      display: grid;
    }

    .site-nav {
      display: none;
    }

    .site-header[data-open] .site-nav {
      display: block;
    }

    .site-header[data-open] .icon-btn > .when-open {
      display: grid;
    }

    .site-header[data-open] .icon-btn > .when-closed {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const setOpen = (open: boolean) => {
    header?.toggleAttribute('data-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('sumi-theme', next);
    } catch {
      /* storage unavailable — the choice lasts for this page view only */
    }
  });
</script>
