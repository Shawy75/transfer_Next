---
import type { MarkdownHeading } from 'astro';
import { SITE } from '@/site.config';

interface Props {
  headings: MarkdownHeading[];
}

interface Node extends MarkdownHeading {
  children: Node[];
}

const { minDepth, maxDepth } = SITE.toc;
const headings = Astro.props.headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);

// Build a nested tree so the list mirrors the document outline.
const root: Node[] = [];
const stack: Node[] = [];
for (const heading of headings) {
  const node: Node = { ...heading, children: [] };
  while (stack.length && stack[stack.length - 1].depth >= node.depth) stack.pop();
  (stack.length ? stack[stack.length - 1].children : root).push(node);
  stack.push(node);
}

let counter: number[] = [];
function number(depth: number): string {
  const level = depth - minDepth;
  counter = counter.slice(0, level + 1);
  while (counter.length <= level) counter.push(0);
  counter[level] += 1;
  return counter.join('.');
}

function render(nodes: Node[]): string {
  return `<ol>${nodes
    .map((n) => {
      const num = number(n.depth);
      const text = n.text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
      return `<li><a href="#${encodeURIComponent(n.slug)}" data-toc-link="${n.slug}"><span class="toc-num">${num}</span> <span class="toc-text">${text}</span></a>${n.children.length ? render(n.children) : ''}</li>`;
    })
    .join('')}</ol>`;
}
---

{headings.length > 0 && <nav class="toc" aria-label="Table of contents" set:html={render(root)} />}

<style>
  .toc {
    position: relative;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: 0.875rem;
    line-height: 1.5;
    overscroll-behavior: contain;
  }

  .toc :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc :global(ol ol) {
    padding-left: 1rem;
  }

  .toc :global(a) {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--text-soft);
  }

  .toc :global(a:hover) {
    color: var(--accent);
    text-decoration: none;
  }

  .toc :global(a.active) {
    color: var(--accent);
    background: var(--surface-2);
    font-weight: 500;
  }

  .toc :global(.toc-num) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  // Scroll-spy: highlight the entry for the section currently in view.
  // A post can render the TOC twice (side rail + collapsible inline copy), so each id maps to several links.
  const links = new Map<string, HTMLAnchorElement[]>();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
    const id = link.dataset.tocLink!;
    links.set(id, [...(links.get(id) ?? []), link]);
  }
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // Keep the active entry visible inside the TOC's own scroll box without moving the page.
  const keepVisible = (link: HTMLAnchorElement) => {
    const box = link.closest<HTMLElement>('.toc');
    if (!box || box.offsetParent === null || box.scrollHeight <= box.clientHeight) return;
    const top = link.offsetTop; // .toc is position: relative, so this is relative to the box
    if (top < box.scrollTop || top > box.scrollTop + box.clientHeight - link.offsetHeight) {
      box.scrollTop = top - box.clientHeight / 2;
    }
  };

  if (headings.length) {
    let activeId = '';
    const update = () => {
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 96) current = heading;
        else break;
      }
      // Short final sections can never reach the top, so treat "scrolled to the bottom" as the last one.
      const root = document.documentElement;
      if (window.scrollY > 0 && window.innerHeight + window.scrollY >= root.scrollHeight - 2) {
        current = headings[headings.length - 1];
      }
      if (current.id === activeId) return;
      for (const link of links.get(activeId) ?? []) link.classList.remove('active');
      for (const link of links.get(current.id) ?? []) {
        link.classList.add('active');
        keepVisible(link);
      }
      activeId = current.id;
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();
  }
</script>
