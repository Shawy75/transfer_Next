---
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import Icon from './Icon.astro';

const t = useStrings(SITE.locale);
---

<button class="back-to-top" type="button" aria-label={t.backToTop} title={t.backToTop} data-back-to-top hidden>
  <Icon name="arrowUp" size={16} />
  <span class="percent" data-percent>0%</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    padding: 0.45rem 0.4rem 0.3rem;
    min-width: 2.75rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.65rem;
    line-height: 1.2;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .back-to-top:hover {
    opacity: 1;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .percent {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const percent = button?.querySelector<HTMLElement>('[data-percent]');
  if (button && percent) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      button.hidden = window.scrollY < 200;
      percent.textContent = `${Math.round(ratio * 100)}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    button.addEventListener('click', () => window.scrollTo({ top: 0 }));
    update();
  }
</script>
