---
/**
 * The item box: the blog's sections shown as game items. Every count and stat is
 * computed from the posts at build time. Hover, focus or tap a slot to read its card.
 */
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import { formatDate } from '@/utils/date';
import { withBase } from '@/utils/url';
import {
  BUCKET_TIER,
  codeBlockCount,
  countWords,
  getCategories,
  getPosts,
  getTags,
  groupByYear,
  readingBucket,
  readingTime,
  type ReadingBucket,
} from '@/utils/posts';
import { itemIconSvg, type ItemIconName, type Tier } from './item-icons';

const t = useStrings(SITE.locale);
const s = t.stats;
const v = t.statValues;
const posts = await getPosts();
const categories = getCategories(posts);
const tags = getTags(posts);
const years = groupByYear(posts);
const busiest = [...years].sort((a, b) => b[1].length - a[1].length)[0];
const totalWords = posts.reduce((n, p) => n + countWords(p.body ?? ''), 0);
const fmt = (n: number) => n.toLocaleString(SITE.locale);

const bucket = (b: ReadingBucket) => posts.filter((p) => readingBucket(p) === b);
const minutes = (list: typeof posts) => list.map((p) => readingTime(p.body ?? ''));
const avg = (list: number[]) => (list.length ? Math.round(list.reduce((a, b) => a + b, 0) / list.length) : 0);
const quick = bucket('quick');
const long = bucket('long');
const deep = bucket('deep');
const codeCounts = posts.map(codeBlockCount);
const codeTotal = codeCounts.reduce((a, b) => a + b, 0);
const contact = SITE.social.find((l) => !l.href.endsWith('.xml'));

interface Item {
  key: string;
  icon: ItemIconName;
  tier: Tier;
  name: string;
  kind: string;
  text: string;
  qty: number | null;
  stats: [string, string][];
  href?: string;
  lantern?: boolean;
}

const items: Item[] = [
  {
    key: 'articles', icon: 'scroll', tier: 0, ...t.items.articles, qty: posts.length,
    stats: [[s.latest, posts[0] ? formatDate(posts[0].data.date) : '—'], [s.words, fmt(totalWords)]],
    href: '/archives/',
  },
  {
    key: 'archive', icon: 'chest', tier: 2, ...t.items.archive, qty: years.length,
    stats: [
      [s.years, years.length ? `${years[years.length - 1][0]} – ${years[0][0]}` : '—'],
      [s.busiest, busiest ? `${busiest[0]} · ${v.postsN(busiest[1].length)}` : '—'],
    ],
    href: '/archives/',
  },
  {
    key: 'categories', icon: 'pouch', tier: 1, ...t.items.categories, qty: categories.length,
    stats: [
      [s.largest, categories[0] ? `${categories[0].name} · ${categories[0].posts.length}` : '—'],
      [s.newest, posts.find((p) => p.data.category)?.data.category ?? '—'],
    ],
    href: '/categories/',
  },
  {
    key: 'tags', icon: 'tag', tier: 0, ...t.items.tags, qty: tags.length,
    stats: [
      [s.mostUsed, tags.slice(0, 2).map((x) => x.name).join(' · ') || '—'],
      [s.newest, posts.find((p) => p.data.tags.length)?.data.tags[0] ?? '—'],
    ],
    href: '/tags/',
  },
  {
    key: 'search', icon: 'spyglass', tier: 3, ...t.items.search, qty: null,
    stats: [[s.index, v.postsN(posts.length)], [s.words, fmt(totalWords)]],
    href: '/search/',
  },
  {
    key: 'about', icon: 'brush', tier: 2, ...t.items.about, text: SITE.author.bio, qty: 1,
    stats: [[s.name, SITE.author.name], [s.elsewhere, contact?.name ?? '—']],
    href: '/about/',
  },
  {
    key: 'quick', icon: 'potion', tier: BUCKET_TIER.quick, ...t.items.quick, qty: quick.length,
    stats: [[s.length, v.under(5)], [s.average, quick.length ? v.minutes(avg(minutes(quick))) : '—']],
    href: '/items/quick/',
  },
  {
    key: 'long', icon: 'potion', tier: BUCKET_TIER.long, ...t.items.long, qty: long.length,
    stats: [[s.length, v.range(5, 15)], [s.average, long.length ? v.minutes(avg(minutes(long))) : '—']],
    href: '/items/long/',
  },
  {
    key: 'deep', icon: 'potion', tier: BUCKET_TIER.deep, ...t.items.deep, qty: deep.length,
    stats: [[s.length, v.over(15)], [s.longest, deep.length ? v.minutes(Math.max(...minutes(deep))) : '—']],
    href: '/items/deep/',
  },
  {
    key: 'code', icon: 'ore', tier: 2, ...t.items.code, qty: codeTotal,
    stats: [[s.blocks, fmt(codeTotal)], [s.inPosts, v.postsN(codeCounts.filter(Boolean).length)]],
    href: '/items/code/',
  },
  {
    key: 'lantern', icon: 'lantern', tier: 0, ...t.items.lantern, qty: 1,
    stats: [[s.default, SITE.defaultTheme === 'auto' ? v.followsSystem : SITE.defaultTheme], [s.remembers, v.yourChoice]],
    lantern: true,
  },
  {
    key: 'horn', icon: 'horn', tier: 1, ...t.items.horn, qty: 1,
    stats: [[s.feed, withBase('/rss.xml')], [s.format, 'RSS 2.0']],
    href: '/rss.xml',
  },
];

const swatch = (tier: Tier) =>
  `<svg class="item-icon swatch" viewBox="0 0 14 14" aria-hidden="true"><rect class="o ${['fl', 'fd', 'fh', 'fs'][tier]}" x="1" y="1" width="12" height="12" rx="1.5"/></svg>`;
---

<section class="item-box wrap" aria-labelledby="item-box-title" data-item-box>
  <div class="section-head">
    <h2 id="item-box-title">{t.itemBox}</h2>
    <span class="mono">{items.length} / {items.length}</span>
  </div>

  <div class="layout">
    <div class="slots" role="group" aria-label={t.itemBox}>
      {
        items.map((it, i) => (
          <button
            class="slot"
            type="button"
            data-i={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`item-${it.key}`}
            aria-label={it.qty == null ? it.name : `${it.name} ×${it.qty}`}
          >
            <Fragment set:html={itemIconSvg(it.icon, it.tier)} />
            {it.qty != null && <span class="qty mono">×{it.qty}</span>}
          </button>
        ))
      }
    </div>

    {/* All cards share one grid cell, so the panel keeps the height of the tallest card. */}
    <div class="cards">
      {
        items.map((it, i) => (
          <div class="card-item" id={`item-${it.key}`} data-i={i} data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="top">
              <Fragment set:html={itemIconSvg(it.icon, it.tier)} />
              <div class="title">
                <h3>{it.name}</h3>
                <span class="sub mono">
                  {it.kind}
                  {it.qty != null && ` · ${t.owned(it.qty)}`}
                </span>
              </div>
            </div>
            <p class="text">{it.text}</p>
            <dl>
              <dt>{t.rarity}</dt>
              <dd>
                <Fragment set:html={swatch(it.tier)} />
                {t.rarities[it.tier]}
              </dd>
              {it.stats.map(([k, val]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{val}</dd>
                </>
              ))}
            </dl>
            <div class="action">
              {it.lantern ? (
                <button class="open" type="button" data-theme-toggle data-label-on={t.nightOn} data-label-off={t.nightOff} tabindex={i === 0 ? 0 : -1}>
                  <span data-theme-label>{t.nightOn}</span> →
                </button>
              ) : (
                <a class="open" href={withBase(it.href!)} tabindex={i === 0 ? 0 : -1}>
                  {t.open} {it.name} →
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .item-box {
    padding-block: 48px 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 28px;
    align-items: center;
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-content: center;
    gap: 14px;
  }

  /* Each slot floats on the paper. Only transform and opacity animate, so hovering stays smooth. */
  .slot {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--lift-rest);
    cursor: pointer;
    transition: transform 0.35s var(--ease);
    will-change: transform;
  }

  /* The deeper hover shadow sits on a pseudo-element and fades in. */
  .slot::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--lift-hover);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }

  /* A short accent stroke under the selected item. */
  .slot::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 18px;
    height: 2px;
    margin-left: -9px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.35s var(--ease);
  }

  .slot :global(.item-icon) {
    width: 62%;
    height: 62%;
    transition: transform 0.45s var(--ease);
  }

  .slot:hover,
  .slot[aria-pressed='true'] {
    transform: translateY(-4px);
  }

  .slot:hover::before,
  .slot[aria-pressed='true']::before {
    opacity: 1;
  }

  .slot[aria-pressed='true'] {
    background: var(--paper-hi);
  }

  .slot[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  .slot:hover :global(.item-icon),
  .slot[aria-pressed='true'] :global(.item-icon) {
    transform: translateY(-2px) scale(1.08) rotate(-3deg);
  }

  .slot:active {
    transform: translateY(-2px) scale(0.97);
    transition-duration: 0.12s;
  }

  .qty {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 0.7rem;
    color: var(--text-soft);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .cards {
    display: grid;
    min-width: 0;
    background: var(--surface);
    border-radius: 8px;
    box-shadow: var(--lift-rest);
  }

  .card-item {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 12px;
    min-width: 0;
    padding: 18px 20px;
  }

  .card-item {
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .card-item:not([data-active]) {
    visibility: hidden;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0s 0.15s;
  }

  .top {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .top :global(.item-icon) {
    width: 52px;
    height: 52px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sub {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.6em * 3);
  }

  dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px 14px;
    margin: 0;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
    font-size: 0.9rem;
  }

  dt {
    padding-top: 2px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  dd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }

  dd :global(.swatch) {
    width: 14px;
    height: 14px;
  }

  .action {
    align-self: end;
  }

  .open {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .open:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .slots {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slot,
    .slot::before,
    .slot::after,
    .slot :global(.item-icon) {
      transition: none;
    }

    .slot:hover :global(.item-icon),
    .slot[aria-pressed='true'] :global(.item-icon) {
      transform: none;
    }
  }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-item-box]')) {
    const slots = [...box.querySelectorAll<HTMLButtonElement>('.slot')];
    const cards = [...box.querySelectorAll<HTMLElement>('.card-item')];
    let current = 0;
    const select = (i: number) => {
      if (i === current) return;
      current = i;
      slots.forEach((s, k) => s.setAttribute('aria-pressed', String(k === i)));
      cards.forEach((c, k) => {
        const on = k === i;
        c.toggleAttribute('data-active', on);
        if (on) c.removeAttribute('aria-hidden');
        else c.setAttribute('aria-hidden', 'true');
        c.querySelector<HTMLElement>('.open')?.setAttribute('tabindex', on ? '0' : '-1');
      });
    };
    slots.forEach((slot, i) => {
      slot.addEventListener('mouseenter', () => select(i));
      slot.addEventListener('focus', () => select(i));
      slot.addEventListener('click', () => select(i));
    });
  }
</script>
