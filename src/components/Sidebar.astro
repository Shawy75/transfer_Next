---
import type { MarkdownHeading } from 'astro';
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import Overview from './Overview.astro';
import TableOfContents from './TableOfContents.astro';

interface Props {
  headings?: MarkdownHeading[];
}

const t = useStrings(SITE.locale);
const { minDepth, maxDepth } = SITE.toc;
const headings = (Astro.props.headings ?? []).filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
const hasToc = SITE.toc.enable && headings.length > 0;
---

<aside class="sidebar card" data-sidebar>
  {
    hasToc ? (
      <>
        <div class="tabs" role="tablist">
          <button type="button" role="tab" id="tab-toc" aria-controls="panel-toc" aria-selected="true" data-tab="toc">
            {t.toc}
          </button>
          <button
            type="button"
            role="tab"
            id="tab-overview"
            aria-controls="panel-overview"
            aria-selected="false"
            data-tab="overview"
          >
            {t.overview}
          </button>
        </div>
        <div class="panel" id="panel-toc" role="tabpanel" aria-labelledby="tab-toc" data-panel="toc">
          <TableOfContents headings={headings} />
        </div>
        <div class="panel" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" data-panel="overview" hidden>
          <Overview />
        </div>
      </>
    ) : (
      <div class="panel">
        <Overview />
      </div>
    )
  }
</aside>

<style>
  .sidebar {
    padding: 1.25rem;
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin: -0.25rem 0 1rem;
    border-bottom: 1px solid var(--border);
  }

  .tabs button {
    padding: 0.25rem 0.1rem 0.5rem;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--muted);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .tabs button[aria-selected='true'] {
    border-bottom-color: var(--accent);
    color: var(--text);
    font-weight: 500;
  }

  /* On small screens the sidebar sits below the content and the post shows an inline TOC instead. */
  @media (max-width: 991px) {
    .tabs,
    [data-panel='toc'] {
      display: none;
    }

    [data-panel='overview'][hidden] {
      display: block;
    }
  }
</style>

<script>
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const tabs = [...(sidebar?.querySelectorAll<HTMLButtonElement>('[data-tab]') ?? [])];
  const select = (tab: HTMLButtonElement) => {
    for (const other of tabs) {
      const selected = other === tab;
      other.setAttribute('aria-selected', String(selected));
      other.tabIndex = selected ? 0 : -1;
      const panel = sidebar?.querySelector<HTMLElement>(`[data-panel="${other.dataset.tab}"]`);
      if (panel) panel.hidden = !selected;
    }
  };
  tabs.forEach((tab, i) => {
    tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
    tab.addEventListener('click', () => select(tab));
    // Arrow keys move between tabs, as in a native tab list.
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
    });
  });

  // Scroll-spy: highlight the TOC entry for the section currently in view.
  // A post can render the TOC twice (sidebar + inline on mobile), so each id maps to several links.
  const links = new Map<string, HTMLAnchorElement[]>();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
    const id = link.dataset.tocLink!;
    links.set(id, [...(links.get(id) ?? []), link]);
  }
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // Keep the active entry visible inside the sidebar's own scroll box without moving the page.
  const keepVisible = (link: HTMLAnchorElement) => {
    const box = link.closest<HTMLElement>('.toc');
    if (!box || box.offsetParent === null || box.scrollHeight <= box.clientHeight) return;
    const top = link.offsetTop; // .toc is position: relative, so this is relative to the box
    if (top < box.scrollTop || top > box.scrollTop + box.clientHeight - link.offsetHeight) {
      box.scrollTop = top - box.clientHeight / 2;
    }
  };

  if (headings.length) {
    let activeId = '';
    const update = () => {
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 96) current = heading;
        else break;
      }
      // Short final sections can never reach the top, so treat "scrolled to the bottom" as the last one.
      const root = document.documentElement;
      if (window.scrollY > 0 && window.innerHeight + window.scrollY >= root.scrollHeight - 2) {
        current = headings[headings.length - 1];
      }
      if (current.id === activeId) return;
      for (const link of links.get(activeId) ?? []) link.classList.remove('active');
      for (const link of links.get(current.id) ?? []) {
        link.classList.add('active');
        keepVisible(link);
      }
      activeId = current.id;
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();
  }
</script>
