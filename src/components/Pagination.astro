---
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  current: number;
  last: number;
  /** URL for a given page number. */
  href: (page: number) => string;
}

const { current, last, href } = Astro.props;
const t = useStrings(SITE.locale);

// Always show first, last, and two pages either side of the current one.
const pages: (number | '…')[] = [];
for (let i = 1; i <= last; i++) {
  if (i === 1 || i === last || Math.abs(i - current) <= 2) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---

{
  last > 1 && (
    <nav class="pagination" aria-label={t.page(current, last)}>
      {current > 1 ? (
        <a class="step" href={href(current - 1)} rel="prev" aria-label={t.newer}>
          <Icon name="arrowLeft" size={16} />
        </a>
      ) : (
        <span class="step disabled" aria-hidden="true">
          <Icon name="arrowLeft" size={16} />
        </span>
      )}
      {pages.map((p) =>
        p === '…' ? (
          <span class="gap">…</span>
        ) : p === current ? (
          <span class="page current" aria-current="page">
            {p}
          </span>
        ) : (
          <a class="page" href={href(p)}>
            {p}
          </a>
        ),
      )}
      {current < last ? (
        <a class="step" href={href(current + 1)} rel="next" aria-label={t.older}>
          <Icon name="arrowRight" size={16} />
        </a>
      ) : (
        <span class="step disabled" aria-hidden="true">
          <Icon name="arrowRight" size={16} />
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: calc(var(--gap) * 1.5);
  }

  .page,
  .step,
  .gap {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: var(--radius);
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  a.page,
  a.step {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  a.page:hover,
  a.step:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .current {
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
  }

  :global(:root[data-theme='dark']) .current {
    background: var(--accent);
    color: #fff;
  }

  .disabled {
    opacity: 0.35;
  }
</style>
