---
/**
 * Shared SVG definitions, rendered once per page:
 * - dot and hatch fills for item-icon rarity tiers;
 * - the turbulence filters behind the ink-in-water title hover.
 */
---

<svg class="ink-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ink-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="5" height="5" style="fill:var(--paper-hi)"></rect>
      <line x1="0" y1="0" x2="0" y2="5" style="stroke:var(--text);stroke-width:1.9"></line>
    </pattern>
    <pattern id="ink-dots" width="4.5" height="4.5" patternUnits="userSpaceOnUse">
      <rect width="4.5" height="4.5" style="fill:var(--paper-hi)"></rect>
      <circle cx="2.25" cy="2.25" r="1.05" style="fill:var(--text)"></circle>
    </pattern>
    <filter id="ink-water" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.011 0.024" numOctaves="4" seed="4" result="noise">
        <animate attributeName="baseFrequency" dur="12s" values="0.011 0.024;0.014 0.02;0.011 0.024" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="soft"></feGaussianBlur>
      <feDisplacementMap in="soft" in2="noise" scale="38" xChannelSelector="R" yChannelSelector="G" result="wisp"></feDisplacementMap>
      <feGaussianBlur in="wisp" stdDeviation="2.4"></feGaussianBlur>
    </filter>
    <filter id="ink-haze" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.016" numOctaves="2" seed="11" result="noise">
        <animate attributeName="baseFrequency" dur="16s" values="0.008 0.016;0.01 0.013;0.008 0.016" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="50" xChannelSelector="G" yChannelSelector="R" result="wisp"></feDisplacementMap>
      <feGaussianBlur in="wisp" stdDeviation="4"></feGaussianBlur>
    </filter>
  </defs>
</svg>

<style>
  .ink-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
