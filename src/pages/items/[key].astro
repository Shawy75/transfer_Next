---
/** Lists for the item box entries that are filters: the three reading-time potions and code ore. */
import type { GetStaticPaths } from 'astro';
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ItemIcon from '@/components/ItemIcon.astro';
import PostTimeline from '@/components/PostTimeline.astro';
import { BUCKET_TIER, codeBlockCount, getPosts, readingBucket, type Post, type ReadingBucket } from '@/utils/posts';
import type { ItemIconName, Tier } from '@/components/item-icons';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const buckets: ReadingBucket[] = ['quick', 'long', 'deep'];
  return [
    ...buckets.map((key) => ({
      params: { key },
      props: { key, icon: 'potion' as ItemIconName, tier: BUCKET_TIER[key] as Tier, posts: posts.filter((p) => readingBucket(p) === key) },
    })),
    { params: { key: 'code' }, props: { key: 'code' as const, icon: 'ore' as ItemIconName, tier: 2 as Tier, posts: posts.filter((p) => codeBlockCount(p) > 0) } },
  ];
}) satisfies GetStaticPaths;

interface Props {
  key: ReadingBucket | 'code';
  icon: ItemIconName;
  tier: Tier;
  posts: Post[];
}

const { key, icon, tier, posts } = Astro.props;
const t = useStrings(SITE.locale);
const item = t.items[key];
---

<BaseLayout title={t.itemList(item.name)} description={item.text}>
  <section class="card page-card">
    <div class="icon"><ItemIcon name={icon} tier={tier} size={56} /></div>
    <h1 class="page-title">{item.name}</h1>
    <p class="page-subtitle">{item.text} · {t.postCount(posts.length)}</p>
    {posts.length ? <PostTimeline posts={posts} /> : <p class="empty">—</p>}
  </section>
</BaseLayout>

<style>
  .icon {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }

  .empty {
    text-align: center;
    color: var(--muted);
  }
</style>
