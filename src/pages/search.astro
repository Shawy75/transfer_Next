---
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

const t = useStrings(SITE.locale);
---

<BaseLayout title={t.search} noindex>
  <section class="card page-card">
    <h1 class="page-title">{t.search}</h1>
    <div id="search" data-placeholder={t.searchPlaceholder} data-base={import.meta.env.BASE_URL}></div>
    <p class="unavailable" hidden data-search-unavailable>{t.searchUnavailable}</p>
  </section>
</BaseLayout>

<style>
  #search {
    margin-top: 1.5rem;
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }

  .unavailable {
    color: var(--muted);
    text-align: center;
  }
</style>

<script>
  // Pagefind's index is generated by `pagefind --site dist` after `astro build`,
  // so it only exists in production builds and `npm run preview`.
  const container = document.getElementById('search');
  const showUnavailable = () => {
    document.querySelector<HTMLElement>('[data-search-unavailable]')?.removeAttribute('hidden');
  };

  async function load() {
    const siteBase = (container?.dataset.base ?? '/').replace(/\/?$/, '/');
    const base = `${siteBase}pagefind/`;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = `${base}pagefind-ui.css`;
    document.head.append(css);

    const script = document.createElement('script');
    script.src = `${base}pagefind-ui.js`;
    script.onerror = showUnavailable;
    script.onload = () => {
      const PagefindUI = (window as unknown as { PagefindUI?: new (opts: object) => unknown }).PagefindUI;
      if (!PagefindUI || !container) return showUnavailable();
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        baseUrl: siteBase,
        translations: { placeholder: container.dataset.placeholder },
      });
      const query = new URLSearchParams(location.search).get('q');
      const input = container.querySelector<HTMLInputElement>('input');
      if (input) {
        input.setAttribute('aria-label', container.dataset.placeholder ?? 'Search');
        if (query) {
          input.value = query;
          input.dispatchEvent(new Event('input'));
        }
        input.focus();
      }
    };
    document.head.append(script);
  }

  load();
</script>
