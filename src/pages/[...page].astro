---
import type { GetStaticPaths, Page } from 'astro';
import { SITE } from '@/site.config';
import { useStrings } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getPosts, sortForHome, type Post } from '@/utils/posts';
import { withBase } from '@/utils/url';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = sortForHome(await getPosts());
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const t = useStrings(SITE.locale);
const title = page.currentPage > 1 ? t.page(page.currentPage, page.lastPage) : undefined;
---

<BaseLayout title={title}>
  <h1 class="sr-only">{SITE.title}{title ? ` — ${title}` : ''}</h1>
  {page.data.length === 0 && <p class="card page-card empty">{t.noPosts}</p>}
  {page.data.map((post) => <PostCard post={post} />)}
  <Pagination current={page.currentPage} last={page.lastPage} href={(n) => withBase(n === 1 ? '/' : `/${n}/`)} />
</BaseLayout>

<style>
  .empty {
    margin: 0;
    color: var(--muted);
    text-align: center;
  }
</style>
