{
  "name": "sumi-astro-theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Sumi — a clean, minimal blog theme for Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/search-index.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "new": "node scripts/new-post.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.6",
    "katex": "0.19.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
